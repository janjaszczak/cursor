# Example environment variables for Cursor MCP configuration
# Copy this file to .env and fill in your actual secrets
# .env is in .gitignore and will NOT be committed

# Neo4j auth for MCP Memory (mcp/neo4j-memory via scripts/mcp-run-memory.py).
# The launcher always connects with NEO4J_URL=bolt://neo4j:7687 on mcp-network.
# NEO4J_URI below is optional/legacy (host tools); it does NOT configure the Memory MCP container.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD_HERE
NEO4J_DATABASE=neo4j

# GitHub Configuration
GITHUB_PERSONAL_ACCESS_TOKEN=YOUR_GITHUB_TOKEN_HERE

# Grafana Configuration
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=YOUR_GRAFANA_API_KEY_HERE

# Postman Configuration
POSTMAN_API_KEY=YOUR_POSTMAN_API_KEY_HERE

# Perplexity (API / MCP integrations)
# Paid per-request MCP search — kept only as an escalation path for explicit
# deep-research/high-stakes requests. Default search is now the free,
# self-hosted searxng/duckduckgo MCP servers (see doc/mcp.md).
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE

# SearXNG (self-hosted search engine, see docker/mcp-searxng/ and scripts/start-searxng.sh)
# Low-sensitivity CSRF/session token for the local-only engine container.
# Auto-generated by start-searxng.sh if left empty here; set it to keep
# sessions stable across container restarts.
SEARXNG_SECRET=
